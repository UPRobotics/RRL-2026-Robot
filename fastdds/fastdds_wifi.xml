<?xml version="1.0" encoding="UTF-8"?>
<!-- FastDDS WiFi profile — RRL 2026 Robot -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <!-- Transporte UDP personalizado -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udpv4_wifi</transport_id>
      <type>UDPv4</type>
      <non_blocking_send>true</non_blocking_send>
      <sendBufferSize>1048576</sendBufferSize>
      <receiveBufferSize>4194304</receiveBufferSize>
      <maxMessageSize>65500</maxMessageSize>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="default_participant" is_default_profile="true">
    <rtps>

      <userTransports>
        <transport_id>udpv4_wifi</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>

      <builtin>
        <!-- Descubrimiento SIMPLE unicast -->
        <discovery_config>
          <discoveryProtocol>SIMPLE</discoveryProtocol>
          
          <!-- Corregido a CamelCase -->
          <initialAnnouncements>
            <count>10</count>
            <period>
              <nanosec>200000000</nanosec> 
            </period>
          </initialAnnouncements>
          
          <!-- Corregido a CamelCase estándar -->
          <leaseAnnouncement>
            <sec>1</sec>
            <nanosec>0</nanosec>
          </leaseAnnouncement>
          
          <leaseDuration>
            <sec>10</sec>
            <nanosec>0</nanosec>
          </leaseDuration>
        </discovery_config>

        <!-- Recibir descubrimiento en este puerto -->
        <metatrafficUnicastLocatorList>
          <locator>
            <udpv4>
              <port>7412</port>
            </udpv4>
          </locator>
        </metatrafficUnicastLocatorList>

        <!-- Fixed Unicast Targets -->
        <initialPeersList>
          <locator>
            <udpv4>
              <address>192.168.0.254</address>
              <port>7412</port>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.0.70</address>
              <port>7412</port>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.0.50</address> 
              <port>7412</port>
            </udpv4>
          </locator>
        </initialPeersList>

        <avoid_builtin_multicast>true</avoid_builtin_multicast>
      </builtin>

      <allocation>
        <send_buffers>
          <preallocated_number>16</preallocated_number>
          <dynamic>false</dynamic>
        </send_buffers>
      </allocation>

    </rtps>
  </participant>
</profiles>
