<?xml version="1.0"?>
<package format="3">
  <name>autonomy_dashboard_pkg</name>
  <version>0.0.1</version>
  <description>RoboCup Rescue 2026 Autonomy Dashboard - Real-time mapping and navigation visualization</description>

  <maintainer email="dev@robocup2026.com">RoboCup Team</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
