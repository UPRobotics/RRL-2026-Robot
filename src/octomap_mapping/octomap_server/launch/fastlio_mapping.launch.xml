<launch>
  <node pkg="octomap_server" exec="octomap_server_node" name="octomap_server">
    <param name="resolution" value="0.05" />
    <param name="frame_id" value="map" />
    <param name="sensor_model.max_range" value="10.0" />
    <param name="sensor_model.hit" value="0.7" />
    <param name="sensor_model.miss" value="0.4" />
    <param name="sensor_model.min" value="0.12" />
    <param name="sensor_model.max" value="0.97" />
    <param name="publish_2d_projected_map" value="true" />
    <param name="project_complete_map" value="true" />
    <param name="occupancy_min_z" value="0.10" />
    <param name="occupancy_max_z" value="1.0" />
    <param name="pointcloud_min_z" value="-0.5" />
    <param name="pointcloud_max_z" value="2.0" />
    <remap from="cloud_in" to="/cloud_filtered" />
  </node>
</launch>